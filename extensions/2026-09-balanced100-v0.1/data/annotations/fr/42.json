        "colspan": 6,
        "source_page": 1,
        "nest_contribution": false
      }
    ],
    [
      {
        "text": "DÉCLARATION À ADRESSER AU CRPV DONT VOUS DEPENDEZ GÉOGRAPHIQUEMENT",
