    [
      {
        "text": "Le distributeur ne s'engage pas à maintenir la fourniture en cas d'incident. Le malade doit disposer d'une source autonome d'électricité.",
        "colspan": 6,
        "heading": false,
        "source_page": 1
      }
    ],
